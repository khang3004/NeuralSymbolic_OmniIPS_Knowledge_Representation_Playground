# ==============================================================================
#             GeoIPS — Plane Geometry IPS Configuration (Example)
# ==============================================================================
# Copy this file to '.env' and fill in your actual values.

# FastAPI Server Config
HOST=0.0.0.0
PORT=8080

# Neo4j Database Config
# Use bolt://localhost:7687 for local dev; bolt://neo4j:7687 inside Docker
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=geo_ips_password

# --------------------------------------------------------------------------
# Qdrant Vector DB — choose mode: "cloud" or "local"
# --------------------------------------------------------------------------
QDRANT_MODE=local

# Cloud mode: sign up free at https://cloud.qdrant.io
# Fill both fields below when QDRANT_MODE=cloud
QDRANT_CLOUD_URL=https://your-cluster.qdrant.tech
QDRANT_CLOUD_API_KEY=your_qdrant_cloud_api_key

# Local mode: used when QDRANT_MODE=local
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# --------------------------------------------------------------------------
# LLM API Keys (model-agnostic, LangChain)
# Supported providers: google, groq, openai, ollama
# --------------------------------------------------------------------------
GEMINI_API_KEY_1=your_gemini_api_key
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

GROQ_API_KEY_1=your_groq_api_key
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# Model-Agnostic LLM Configuration
# Supported Providers: openai, ollama, groq, google
LLM_PROVIDER=google
LLM_MODEL=gemma-4-31b-it
LLM_API_KEY=your_llm_api_key_here